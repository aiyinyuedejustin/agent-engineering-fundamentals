    {
      "id": "IP21",
      "title": "Large-file two-stage upload",
      "finding": "A higher-capability conversation-bound path can precede the ordinary 30 MiB guard. It first prepares a server filename/path and identity, then submits bytes to file storage, checks source/stored size agreement, and conditionally cleans up failed partial results.",
      "classification": "observed_packaged_client_control_flow",
      "conditions": [
        "Requires conversation identity and a higher configured upload cap.",
        "Cleanup avoids deleting paths that may still be shared or held."
